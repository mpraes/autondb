{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "autondb",
  "version": "0.1.0",
  "identifier": "com.autondb.app",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "AutonDB — AI Database Migration",
        "width": 960,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/autondb-core"],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
